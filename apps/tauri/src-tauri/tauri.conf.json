{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-utils/schema.json",
  "productName": "QuicFuscate",
  "version": "0.4.0",
  "identifier": "com.quicfuscate.desktop",
  "build": {
    "frontendDist": "../../svelte-desktop/build",
    "devUrl": "http://localhost:4173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "QuicFuscate",
        "width": 900,
        "height": 670,
        "minWidth": 900,
        "minHeight": 670,
        "maxWidth": 900,
        "maxHeight": 670,
        "resizable": false,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset:; img-src 'self' tauri: asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "QuicFuscate"
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Christopher-Schulze/QuicFuscate/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGMzRBOUQ5Nzk1OEJGMzYKUldRMnYxaDUyYWswLzdiT1N5a1g2ZVdkYTNrRkRpSnh5UUpmdnI3d2Z4a21jNlppbk1QRWVJdkEK"
    }
  }
}
