{
  "name": "quicfuscate-svelte-admin",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 1430 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "serve:codex": "bun run build && bun ../../scripts/tests/frontend/run-bounded-preview.ts --host=127.0.0.1 --port=1430",
    "test:serve:codex": "bun test --no-orphans --timeout=10000 ../../scripts/tests/frontend/run-bounded-preview.test.ts",
    "test": "bun run test:unit",
    "test:unit": "bun ../../scripts/tests/frontend/run-bounded-unit-tests.ts --minimum-files=27 --minimum-tests=391",
    "test:unit:watch": "vitest --config vitest.config.ts --watch",
    "test:e2e:install": "bunx playwright install chromium",
    "test:e2e:preflight": "bash ../../scripts/tests/frontend/verify-playwright-browser.sh apps/svelte-admin",
    "test:e2e": "bun run test:e2e:preflight && NODE_PATH=./node_modules env -u NO_COLOR -u FORCE_COLOR playwright test",
    "test:e2e:ui": "bun run test:e2e:preflight && NODE_PATH=./node_modules env -u NO_COLOR -u FORCE_COLOR playwright test --ui",
    "test:e2e:debug": "bun run test:e2e:preflight && NODE_PATH=./node_modules env -u NO_COLOR -u FORCE_COLOR playwright test --debug"
  },
  "dependencies": {
    "@quicfuscate/theme": "workspace:*",
    "@quicfuscate/time": "workspace:*",
    "@quicfuscate/ui": "workspace:*",
    "@quicfuscate/types": "workspace:*",
    "@quicfuscate/i18n": "workspace:*",
    "@quicfuscate/error-reporting": "workspace:*",
    "smol-toml": "1.6.1",
    "bits-ui": "^2.16.3",
    "clsx": "^2.1.1",
    "@lucide/svelte": "^0.577.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@playwright/test": "1.58.2",
    "@axe-core/playwright": "4.11.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.2.8",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.0.6",
    "jsdom": "^28.0.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.4.2",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
