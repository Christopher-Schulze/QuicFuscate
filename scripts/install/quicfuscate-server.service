[Unit]
Description=QuicFuscate Server (QUIC tunnel + Admin Web Panel)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
# Keep privileged setup as UID 0 while granting access to group-protected
# runtime state before the server irreversibly drops to quicfuscate:quicfuscate.
Group=quicfuscate
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_IPC_LOCK CAP_CHOWN CAP_SETGID CAP_SETUID

# Runtime configuration (credentials, bind addresses, paths).
EnvironmentFile=/etc/quicfuscate/quicfuscate.env

# Every expansion is quoted. Unquoted ${VAR} in ExecStart is split on whitespace by systemd, so a
# path containing a space would become two arguments and the unit would start with different
# arguments than the installer reported. "${VAR}" always expands to exactly one argument.
ExecStart=/usr/local/bin/quicfuscate server \
  --listen "${QUICFUSCATE_LISTEN}" \
  --cert "${QUICFUSCATE_CERT}" \
  --key "${QUICFUSCATE_KEY}" \
  --config "${QUICFUSCATE_CONFIG}" \
  --admin-web "${QUICFUSCATE_ADMIN_WEB}" \
  --admin-web-root "${QUICFUSCATE_ADMIN_WEB_ROOT}" \
  --qkey-store "${QUICFUSCATE_QKEY_STORE}" \
  --qkey-ttl-secs "${QUICFUSCATE_QKEY_TTL_SECS}"
ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10s

# Basic hardening. The admin panel needs to write /etc/quicfuscate when you use the
# in-panel config editor.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/etc/quicfuscate /var/lib/quicfuscate /var/log/quicfuscate

# Tune for higher connection counts.
LimitNOFILE=1048576

# Allow mlockall to lock process memory against swap (key material, AEAD state).
# Required by TODO-440 memory-locking acceptance criterion once the runtime
# mlockall call is wired in (see TODO-516).
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
